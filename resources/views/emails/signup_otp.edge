{{--
  Código OTP de verificación de correo durante el registro self-service.

  Comparte el sistema visual de `magic_link.edge`, `password_recovery.edge` y
  `new_password.edge`: misma tarjeta, mismo logo, mismas reglas y misma paleta.
  Reutiliza el bloque del código de verificación de `password_recovery.edge`.
  Tarjeta, logo, reglas y pie: `components/emails/card.edge`.
--}}
@component('components/emails/card', {
  subject, preheader, tradeName, backgroundImageLogo, footer,
})
  @slot('head')
      .signup-otp-code { font-size: 38px !important; }
  @end

  {{-- Saludo e intro en un solo párrafo: el diseño resalta solo el nombre --}}
  <p style="margin: 32px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
    {{ greetingLead }} <strong style="color: #17224d;">{{ firstName }}</strong>. {{ intro }}
  </p>

  {{-- Código de verificación --}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 23px 0 0 0; background-color: #eef1fa; border-radius: 8px;">
    <tr>
      <td align="center" style="padding: 30px 24px 34px 24px;">
        <p style="margin: 0; font-size: 11px; line-height: 16px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; color: #6e757c;">
          {{ codeLabel }}
        </p>
        <p class="signup-otp-code" style="margin: 13px 0 0 0; font-size: 50px; line-height: 56px; font-weight: 700; letter-spacing: 2px; color: #17224d;">
          {{ pinCode }}
        </p>
      </td>
    </tr>
  </table>

  {{-- Vigencia: el `<strong>` viene del catálogo i18n, por eso se imprime sin escapar --}}
  <p style="margin: 22px 0 0 0; font-size: 13px; line-height: 21px; color: #4b5057;">
    {{{ validity }}}
  </p>

  <p style="margin: 21px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
    {{ ignoreNotice }}
  </p>
@end
