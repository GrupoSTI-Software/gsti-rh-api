{{--
  Aviso interno: pago registrado pero aumento quedó not_applicable (USRH1786107870856).
  Estilos inline y layout con tablas (Gmail / Outlook).
--}}<!DOCTYPE html>
<html lang="es" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1f2937;">

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f4f6fa;">
    <tr>
      <td align="center" style="padding: 24px 12px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width: 100%; max-width: 640px;">

          <tr>
            <td style="background-color: {{ sidebarColor }}; padding: 18px 24px; border-top-left-radius: 12px; border-top-right-radius: 12px; color: #ffffff;">
              <div style="font-size: 18px; font-weight: 700; line-height: 1.2; color: #ffffff;">{{ tradeName }}</div>
              <div style="font-size: 13px; color: #e0f2fe; margin-top: 4px;">Aumento no aplicable — aviso interno</div>
            </td>
          </tr>

          <tr>
            <td style="background-color: #ffffff; padding: 24px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">

              <p style="margin: 0 0 20px; font-size: 15px; line-height: 1.5; color: #111827;">
                Se registró un pago sobre la suscripción <strong>#{{ billingSubscriptionId }}</strong> de
                <strong>{{ businessUnitName }}</strong>, pero el aumento de cantidad quedó en estado
                <strong>not_applicable</strong>. Requiere revisión manual de operaciones.
              </p>

              <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.5; color: #374151; background: #fef3c7; border-left: 4px solid #f59e0b; padding: 12px 14px;">
                <strong>Motivo:</strong> {{ reasonLabel }}<br />
                <span style="font-size: 12px; color: #6b7280;">Código: {{ reasonCode }}</span>
              </p>

              <p style="margin: 0 0 8px; font-size: 13px; font-weight: 600; color: #374151;">Detalle</p>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
                <tbody>
                  <tr>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #374151; width: 45%;">Empresa</td>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #111827; font-weight: 600;">{{ businessUnitName }}</td>
                  </tr>
                  <tr>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #374151;">Plan</td>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #111827; font-weight: 600;">{{ billingPlanName }}</td>
                  </tr>
                  <tr>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #374151;">Folio de cambio</td>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #111827; font-weight: 600;">#{{ billingSubscriptionChangeId }}</td>
                  </tr>
                  <tr>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #374151;">Cantidad (antes → pedida)</td>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #111827; font-weight: 600;">{{ previousEmployees }} → {{ newEmployees }} empleados</td>
                  </tr>
                  <tr>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #374151;">Pago registrado</td>
                    <td style="padding: 9px 8px; border-bottom: 1px solid #f3f4f6; color: #111827; font-weight: 600;">#{{ billingPaymentId }} — {{ amountPaid }}</td>
                  </tr>
                  <tr>
                    <td style="padding: 9px 8px; color: #374151;">Adeudo prorrateado congelado</td>
                    <td style="padding: 9px 8px; color: #111827; font-weight: 600;">{{ proratedDue }}</td>
                  </tr>
                </tbody>
              </table>

              <p style="margin: 0; font-size: 12px; line-height: 1.5; color: #6b7280;">
                El pago quedó asentado; el cupo de la empresa no subió automáticamente.
                Coordina con el cliente la resolución manual del aumento.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding: 16px 8px 0; font-size: 11px; color: #9ca3af; text-align: center;">
              {{ tradeName }} — aviso operativo interno
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
