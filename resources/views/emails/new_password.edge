{{--
  Aviso de contraseña actualizada: se envía cuando el usuario termina el
  restablecimiento, para que un cambio no reconocido se detecte de inmediato.
  NO transporta la contraseña: solo confirma el cambio y ofrece la ruta de
  reporte.

  Comparte el sistema visual de `magic_link.edge` y `password_recovery.edge`:
  misma tarjeta, mismo logo, mismas reglas y misma paleta.

  Medidas tomadas del diseño aprobado (agosto 2026) y escaladas a una tarjeta
  de 600px: el mock mide 1134px de tarjeta, así que cada valor va multiplicado
  por 0.529.

  Paleta del diseño:
    #f2f3f6 fondo · #ffffff tarjeta · #dfe2e6 bordes y reglas
    #17224d títulos y nombre · #4b5057 cuerpo · #6e757c texto secundario
    #445cba acento (CTA y enlaces)
--}}<!DOCTYPE html>
<html lang="es" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <title>{{ subject }}</title>
  <style>
    @media only screen and (max-width: 480px) {
      .password-changed-card { padding: 28px 24px 48px 24px !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f2f3f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #4b5057; -webkit-font-smoothing: antialiased;">
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">
    {{ preheader }}
  </div>

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f2f3f6;">
    <tr>
      <td align="center" style="padding: 16px 12px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #dfe2e6; border-radius: 8px;">
          <tr>
            <td class="password-changed-card" style="padding: 39px 57px 80px 57px;">

              {{-- Logo. El margen negativo compensa el 8% transparente del asset --}}
              @if (backgroundImageLogo)
                <img src="{{ backgroundImageLogo }}" alt="{{ tradeName }}" height="42" style="height: 42px; width: auto; display: block; border: 0; margin-left: -16px;" />
              @else
                <p style="margin: 0; font-size: 24px; font-weight: 700; color: #17224d;">{{ tradeName }}</p>
              @end

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td style="padding: 19px 0 0 0; font-size: 0; line-height: 0;">
                    <div style="height: 1px; background-color: #dfe2e6; font-size: 0; line-height: 1px;">&nbsp;</div>
                  </td>
                </tr>
              </table>

              <h1 style="margin: 33px 0 0 0; font-size: 24px; line-height: 31px; font-weight: 700; color: #17224d;">
                {{ title }}
              </h1>

              {{-- Saludo e intro en un solo párrafo: el diseño resalta solo el nombre --}}
              <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
                {{ greetingLead }} <strong style="color: #17224d;">{{ firstName }}</strong>. {{ intro }}
              </p>

              {{-- CTA. Solo cuando hay a dónde llevar: el aviso se manda igual
                   desde la app, que no aporta origen de backoffice. --}}
              @if (loginUrl)
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 26px 0 0 0;">
                  <tr>
                    <td style="background-color: #445cba; border-radius: 8px;">
                      <a href="{{ loginUrl }}" target="_blank" style="display: inline-block; padding: 16px 33px; font-size: 13px; font-weight: 700; color: #ffffff; text-decoration: none; line-height: 16px;">
                        {{ cta }}
                      </a>
                    </td>
                  </tr>
                </table>

                <p style="margin: 14px 0 0 0; font-size: 12px; line-height: 20px; color: #6e757c;">
                  {{ ctaCaption }}
                </p>
              @endif

              {{-- Bloque de alerta: qué hacer si el cambio no fue del titular --}}
              <p style="margin: 25px 0 0 0; font-size: 14px; line-height: 22px; font-weight: 700; color: #17224d;">
                {{ alertTitle }}
              </p>

              {{-- `alertBody` trae el enlace de soporte ya compuesto en el servicio --}}
              <p style="margin: 7px 0 0 0; font-size: 13px; line-height: 21px; color: #4b5057;">
                {{{ alertBody }}}
              </p>

              <p style="margin: 21px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
                {{ securityNotice }}
              </p>

              {{-- URL de respaldo para clientes que bloquean el botón --}}
              @if (loginUrl)
                <p style="margin: 22px 0 0 0; font-size: 12px; line-height: 21px; color: #6e757c;">
                  {{ fallbackUrl }}<br />
                  <a href="{{ loginUrl }}" target="_blank" style="color: #445cba; text-decoration: underline; word-break: break-all;">{{ loginUrl }}</a>
                </p>
              @endif

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td style="padding: 31px 0 0 0; font-size: 0; line-height: 0;">
                    <div style="height: 1px; background-color: #dfe2e6; font-size: 0; line-height: 1px;">&nbsp;</div>
                  </td>
                </tr>
              </table>

              <p style="margin: 15px 0 0 0; font-size: 12px; line-height: 20px; color: #6e757c;">
                {{ footer }}
              </p>

            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
