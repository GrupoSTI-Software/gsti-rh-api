{{--
  Correo de notificación de nueva contraseña.

  Convenciones de diseño:
  - Estilos 100% inline: sin bloque <style>. Maximiza compatibilidad con Gmail,
    Outlook y Apple Mail (clientes que recortan o ignoran <style>).
  - Layout basado en tablas: requisito para Outlook 2007-2019.
  - Responsive sin @media: ancho máximo 560px combinado con width="100%".
  - Áreas tappables nunca por debajo de 44px de alto.
  - Logotipo fijo de Valanserh para mantener identidad visual del producto.
--}}<!DOCTYPE html>
<html lang="es" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>Tu nueva contraseña</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1f6b95;">
  {{-- Preheader oculto: aparece como preview en la bandeja de entrada. --}}
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">
    @if (userPassword)
      Estos son los datos de acceso a tu cuenta de Valanserh.
    @else
      La contraseña de tu cuenta de Valanserh se cambió correctamente.
    @endif
  </div>

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f4f6fa;">
    <tr>
      <td align="center" style="padding: 32px 12px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width: 100%; max-width: 560px;">
          {{-- Acento superior --}}
          <tr>
            <td style="background-color: #3d5dc0; height: 4px; line-height: 4px; font-size: 0; border-top-left-radius: 12px; border-top-right-radius: 12px;">&nbsp;</td>
          </tr>

          {{-- Tarjeta principal --}}
          <tr>
            <td style="background-color: #ffffff; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                {{-- Logotipo --}}
                <tr>
                  <td align="center" style="padding: 32px 32px 8px 32px;">
                    <img src="{{ backgroundImageLogo }}" alt="logotipo" width="140" style="width: auto; height: 45px; display: block; border: 0; margin: 0 auto;" />
                  </td>
                </tr>

                {{-- Encabezado --}}
                <tr>
                  <td style="padding: 16px 32px 12px 32px;">
                    <h1 style="margin: 0; font-size: 20px; line-height: 1.2; color: #1f6b95; font-weight: 800; letter-spacing: -0.5px;">
                      @if (userPassword)
                        Tu nueva contraseña
                      @else
                        Contraseña actualizada
                      @endif
                    </h1>
                  </td>
                </tr>

                {{-- Saludo e introducción --}}
                <tr>
                  <td style="padding: 0 32px 24px 32px;">
                    <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #475569;">
                      Hola
                      <strong style="color: #1f6b95; text-transform: capitalize;">{{ user?.person?.personFirstname ?? '' }}</strong>,
                      @if (userPassword)
                        creamos una nueva contraseña para tu cuenta. Usa los siguientes datos para iniciar sesión.
                      @else
                        la contraseña de tu cuenta se cambió correctamente.
                      @endif
                    </p>
                  </td>
                </tr>

                @if (userPassword)
                {{-- Separador "Datos de acceso" --}}
                <tr>
                  <td style="padding: 8px 32px 16px 32px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                      <tr>
                        <td style="border-top: 1px solid #e2e8f0; line-height: 1px; font-size: 0; width: 30%;">&nbsp;</td>
                        <td align="center" style="padding: 0 12px; font-size: 11px; line-height: 1.2; color: #94a3b8; text-transform: uppercase; letter-spacing: 1.5px; white-space: nowrap;">
                          DATOS DE ACCESO
                        </td>
                        <td style="border-top: 1px solid #e2e8f0; line-height: 1px; font-size: 0; width: 30%;">&nbsp;</td>
                      </tr>
                    </table>
                  </td>
                </tr>

                {{-- Bloque de credenciales --}}
                <tr>
                  <td style="padding: 0 32px 20px 32px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #eef2ff; border-radius: 12px;">
                      <tr>
                        <td style="padding: 24px;">
                          <p style="margin: 0 0 4px 0; font-size: 11px; line-height: 1.2; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;">
                            Correo
                          </p>
                          <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.4; color: #1e1b4b; word-break: break-all;">
                            {{ user?.userEmail ?? '' }}
                          </p>
                          <p style="margin: 0 0 4px 0; font-size: 11px; line-height: 1.2; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;">
                            Contraseña
                          </p>
                          <p style="margin: 0; font-family: 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace; font-size: 20px; line-height: 1.2; letter-spacing: 1px; font-weight: 700; color: #1e1b4b; word-break: break-all;">
                            {{ userPassword }}
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                @endif

                {{-- Botón principal --}}
                <tr>
                  <td style="padding: 0 32px 12px 32px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="background-color: #3d5dc0; border-radius: 10px;">
                          <a href="{{ host_data.host_uri }}/" target="_blank" style="display: inline-block; padding: 16px 28px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none; line-height: 1;">
                            Iniciar sesión
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                {{-- Caption del botón --}}
                <tr>
                  <td style="padding: 0 32px 24px 32px;">
                    <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #94a3b8;">
                      Te llevará a la página de inicio de sesión.
                    </p>
                  </td>
                </tr>

                {{-- Nota de seguridad --}}
                <tr>
                  <td style="padding: 0 32px 24px 32px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-top: 1px solid #e2e8f0;">
                      <tr>
                        <td style="padding-top: 20px;">
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td valign="top" style="padding-right: 12px;">
                                <div style="width: 8px; height: 8px; background-color: #6366f1; border-radius: 50%; margin-top: 6px;"></div>
                              </td>
                              <td valign="top">
                                <p style="margin: 0; font-size: 13px; line-height: 1.55; color: #64748b;">
                                  Para proteger tu cuenta, no reenvíes este mensaje a nadie.
                                  @if (userPassword)
                                    <br>
                                    Te recomendamos cambiar tu contraseña después de iniciar sesión.
                                  @endif
                                </p>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {{-- Pie de página --}}
          <tr>
            <td align="center" style="padding: 24px 32px 8px 32px;">
              <p style="margin: 0; font-size: 12px; line-height: 1.5; color: #94a3b8;">
                ¿Necesitas ayuda? Escríbenos a
                <a href="mailto:soporte@valanserh.com" style="color: #3d5dc0; text-decoration: none; font-weight: 600;">soporte@valanserh.com</a>
              </p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 0 32px 32px 32px;">
              <p style="margin: 0; font-size: 12px; line-height: 1.5; color: #94a3b8;">
                © {{ new Date().getFullYear() }} Valanserh · Mensaje automático, no respondas a esta dirección.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
