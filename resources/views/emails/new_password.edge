{{--
  Aviso de contraseña actualizada: se envía cuando el usuario termina el
  restablecimiento, para que un cambio no reconocido se detecte de inmediato.
  NO transporta la contraseña: solo confirma el cambio y ofrece la ruta de
  reporte.
  Tarjeta, logo, reglas y pie: `components/emails/access_card.edge`.
--}}
@component('components/emails/access_card', {
  subject, preheader, tradeName, backgroundImageLogo, footer,
})
  <h1 style="margin: 33px 0 0 0; font-size: 24px; line-height: 31px; font-weight: 700; color: #17224d;">
    {{ title }}
  </h1>

  {{-- Saludo e intro en un solo párrafo: el diseño resalta solo el nombre --}}
  <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
    {{ greetingLead }} <strong style="color: #17224d;">{{ firstName }}</strong>. {{ intro }}
  </p>

  {{-- CTA. Solo cuando hay a dónde llevar: el aviso se manda igual
       desde la app, que no aporta origen de backoffice. --}}
  @if (loginUrl)
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 26px 0 0 0;">
      <tr>
        <td style="background-color: #445cba; border-radius: 8px;">
          <a href="{{ loginUrl }}" target="_blank" style="display: inline-block; padding: 16px 33px; font-size: 13px; font-weight: 700; color: #ffffff; text-decoration: none; line-height: 16px;">
            {{ cta }}
          </a>
        </td>
      </tr>
    </table>

    <p style="margin: 14px 0 0 0; font-size: 12px; line-height: 20px; color: #6e757c;">
      {{ ctaCaption }}
    </p>
  @endif

  {{-- Bloque de alerta: qué hacer si el cambio no fue del titular --}}
  <p style="margin: 25px 0 0 0; font-size: 14px; line-height: 22px; font-weight: 700; color: #17224d;">
    {{ alertTitle }}
  </p>

  {{-- `alertBody` trae el enlace de soporte ya compuesto en el servicio --}}
  <p style="margin: 7px 0 0 0; font-size: 13px; line-height: 21px; color: #4b5057;">
    {{{ alertBody }}}
  </p>

  <p style="margin: 21px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
    {{ securityNotice }}
  </p>

  {{-- URL de respaldo para clientes que bloquean el botón --}}
  @if (loginUrl)
    <p style="margin: 22px 0 0 0; font-size: 12px; line-height: 21px; color: #6e757c;">
      {{ fallbackUrl }}<br />
      <a href="{{ loginUrl }}" target="_blank" style="color: #445cba; text-decoration: underline; word-break: break-all;">{{ loginUrl }}</a>
    </p>
  @endif
@end
