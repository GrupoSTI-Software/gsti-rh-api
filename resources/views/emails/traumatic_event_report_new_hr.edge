{{--
  Aviso a RH de un reporte de evento traumático de origen empleado.

  Datos mínimos por confidencialidad: quién, qué tipo y cuándo. La descripción
  y las personas involucradas solo se consultan dentro del sistema.
  Tarjeta, logo, reglas y pie: `components/emails/card.edge`.
--}}
@component('components/emails/card', {
  subject, preheader, tradeName, backgroundImageLogo, footer,
})
  {{-- Saludo --}}
  <h1 style="margin: 33px 0 0 0; font-size: 24px; line-height: 31px; font-weight: 700; color: #17224d;">
    {{ greeting }}
  </h1>

  {{-- Intro --}}
  <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
    {{ intro }}
  </p>

  {{-- Datos del reporte --}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 27px 0 0 0; background-color: #eef1fa; border-radius: 8px;">
    <tr>
      <td style="padding: 18px 24px 22px 24px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
          <tr>
            <td valign="top" style="padding: 6px 12px 6px 0; font-size: 13px; line-height: 22px; color: #6e757c; white-space: nowrap;">
              {{ workerLabel }}
            </td>
            <td align="right" style="padding: 6px 0; font-size: 13px; line-height: 22px; font-weight: 700; color: #17224d;">
              {{ workerName }}
            </td>
          </tr>
          <tr>
            <td valign="top" style="padding: 6px 12px 6px 0; font-size: 13px; line-height: 22px; color: #6e757c; white-space: nowrap;">
              {{ eventTypeLabel }}
            </td>
            <td align="right" style="padding: 6px 0; font-size: 13px; line-height: 22px; font-weight: 700; color: #17224d;">
              {{ eventTypeName }}
            </td>
          </tr>
          <tr>
            <td valign="top" style="padding: 6px 12px 6px 0; font-size: 13px; line-height: 22px; color: #6e757c; white-space: nowrap;">
              {{ occurredAtLabel }}
            </td>
            <td align="right" style="padding: 6px 0; font-size: 13px; line-height: 22px; font-weight: 700; color: #17224d;">
              {{ occurredAt }}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  {{-- CTA --}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 26px 0 0 0;">
    <tr>
      <td style="background-color: #445cba; border-radius: 8px;">
        <a href="{{ boardUrl }}" target="_blank" style="display: inline-block; padding: 16px 33px; font-size: 13px; font-weight: 700; color: #ffffff; text-decoration: none; line-height: 16px;">
          {{ cta }}
        </a>
      </td>
    </tr>
  </table>

  <p style="margin: 20px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
    {{ confidentialityNote }}
  </p>

  {{-- URL de respaldo para clientes que bloquean el botón --}}
  <p style="margin: 22px 0 0 0; font-size: 12px; line-height: 21px; color: #6e757c;">
    {{ fallbackUrl }}<br />
    <a href="{{ boardUrl }}" target="_blank" style="color: #445cba; text-decoration: underline; word-break: break-all;">{{ boardUrl }}</a>
  </p>
@end
