{{--
  Correo de magic link para acceso sin contraseña al backoffice.
  Tarjeta, logo, reglas y pie: `components/emails/card.edge`.
--}}
@component('components/emails/card', {
  subject, preheader, tradeName, backgroundImageLogo, footer,
})
  {{-- Saludo --}}
  <h1 style="margin: 33px 0 0 0; font-size: 24px; line-height: 31px; font-weight: 700; color: #17224d;">
    {{ greeting }}
  </h1>

  {{-- Intro --}}
  <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
    {{ intro }}
  </p>

  {{-- CTA --}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 26px 0 0 0;">
    <tr>
      <td style="background-color: #445cba; border-radius: 8px;">
        <a href="{{ magicLinkUrl }}" target="_blank" style="display: inline-block; padding: 16px 33px; font-size: 13px; font-weight: 700; color: #ffffff; text-decoration: none; line-height: 16px;">
          {{ cta }}
        </a>
      </td>
    </tr>
  </table>

  {{-- Caja explicativa --}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 27px 0 0 0; background-color: #eef1fa; border-radius: 8px;">
    <tr>
      <td style="padding: 24px 24px 28px 24px;">
        <p style="margin: 0; font-size: 14px; line-height: 22px; font-weight: 700; color: #17224d;">
          {{ infoTitle }}
        </p>
        <p style="margin: 8px 0 0 0; font-size: 13px; line-height: 22px; color: #4b5057;">
          {{ infoBody }}
        </p>
        <div style="margin: 16px 0 0 0;">
          @each (bullet in infoBullets)
            <p style="margin: 0; font-size: 13px; line-height: 22px; color: #4b5057;">
              &middot; {{ bullet }}
            </p>
          @end
        </div>
      </td>
    </tr>
  </table>

  {{-- Vigencia: el `<strong>` viene del catálogo i18n, por eso se imprime sin escapar --}}
  <p style="margin: 20px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
    {{{ validity }}}
  </p>

  <p style="margin: 17px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
    {{ ignoreNotice }}
  </p>

  {{-- URL de respaldo para clientes que bloquean el botón --}}
  <p style="margin: 22px 0 0 0; font-size: 12px; line-height: 21px; color: #6e757c;">
    {{ fallbackUrlLabel }}<br />
    <a href="{{ magicLinkUrl }}" target="_blank" style="color: #445cba; text-decoration: underline; word-break: break-all;">{{ magicLinkUrl }}</a>
  </p>
@end
