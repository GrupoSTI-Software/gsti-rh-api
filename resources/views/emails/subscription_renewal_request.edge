{{--
  Aviso interno: un cliente con la contratacion vencida pidio renovar.

  Mismo layout aprobado que `magic_link.edge` (agosto 2026): tarjeta blanca con
  borde sutil sobre fondo gris, logo alineado a la izquierda, regla divisoria,
  saludo destacado, caja informativa con los datos de la contratacion y pie de
  mensaje automatico. Sin CTA: el equipo responde por correo, no hay pantalla a
  la que mandarlo.
  Tarjeta, logo, reglas y pie: `components/emails/card.edge`.
--}}
@component('components/emails/card', {
  subject, preheader, tradeName, backgroundImageLogo, footer,
})
  {{-- Saludo --}}
  <h1 style="margin: 33px 0 0 0; font-size: 24px; line-height: 31px; font-weight: 700; color: #17224d;">
    {{ greeting }}
  </h1>

  {{-- Intro --}}
  <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
    {{ intro }}
  </p>

  {{-- Datos de la contratacion --}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 27px 0 0 0; background-color: #eef1fa; border-radius: 8px;">
    <tr>
      <td style="padding: 24px 24px 28px 24px;">
        <p style="margin: 0; font-size: 14px; line-height: 22px; font-weight: 700; color: #17224d;">
          {{ detailsTitle }}
        </p>

        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 12px 0 0 0;">
          @each (row in detailRows)
            <tr>
              <td style="padding: 6px 12px 6px 0; font-size: 13px; line-height: 22px; color: #6e757c; white-space: nowrap;">
                {{ row.label }}
              </td>
              <td align="right" style="padding: 6px 0; font-size: 13px; line-height: 22px; font-weight: 700; color: #17224d;">
                {{ row.value }}
              </td>
            </tr>
          @end
        </table>
      </td>
    </tr>
  </table>

  {{-- Quien lo pidio: el equipo responde a esta direccion --}}
  <p style="margin: 20px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
    {{ requesterLabel }}<br />
    <a href="mailto:{{ requesterEmail }}" style="color: #445cba; text-decoration: underline;">{{ requesterValue }}</a>
  </p>

  <p style="margin: 17px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
    {{ nextStep }}
  </p>
@end
