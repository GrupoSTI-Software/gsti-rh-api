{{--
  Aviso de correo de acceso cambiado: sale a cada buzón anterior (variante
  `previous`) y al buzón nuevo (variante `current`) cuando se cambia la
  credencial de un usuario.
  NO transporta contraseña, token ni PIN. El buzón anterior recibe el correo
  nuevo enmascarado y sin CTA: quien controla ese buzón no debe aprender la
  dirección nueva ni tener un atajo de acceso. El buzón nuevo recibe la
  dirección completa y el CTA de inicio de sesión.

  Comparte el sistema visual de `new_password.edge`: misma tarjeta, mismo
  logo, mismas reglas y misma paleta.
  Tarjeta, logo, reglas y pie: `components/emails/card.edge`.
--}}
@component('components/emails/card', {
  subject, preheader, tradeName, backgroundImageLogo, footer,
})
  <h1 style="margin: 33px 0 0 0; font-size: 24px; line-height: 31px; font-weight: 700; color: #17224d;">
    {{ isPreviousRecipient ? titlePrevious : titleCurrent }}
  </h1>

  <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
    {{ greetingLead }}
  </p>

  @if (isPreviousRecipient)
    <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
      {{ bodyPrevious }}
    </p>

    <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
      {{ newEmailLabel }}: <strong style="color: #17224d;">{{ newEmailDisplay }}</strong>
    </p>

    {{-- Bloque de alerta: qué hacer si el cambio no fue del titular --}}
    <p style="margin: 25px 0 0 0; font-size: 14px; line-height: 22px; font-weight: 700; color: #17224d;">
      {{ alertTitle }}
    </p>

    <p style="margin: 7px 0 0 0; font-size: 13px; line-height: 21px; color: #4b5057;">
      {{ alertBody }}
    </p>

    <p style="margin: 21px 0 0 0; font-size: 13px; line-height: 21px; color: #6e757c;">
      {{ supportLinkCaption }}
    </p>
  @else
    <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
      {{ bodyCurrent }}
    </p>

    <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
      {{ newEmailLabel }}: <strong style="color: #17224d;">{{ newEmailDisplay }}</strong>
    </p>

    <p style="margin: 14px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
      {{ passwordUnchangedNotice }}
    </p>

    <p style="margin: 7px 0 0 0; font-size: 13px; line-height: 23px; color: #4b5057;">
      {{ sessionsClosedNotice }}
    </p>

    {{-- CTA. Solo cuando hay a dónde llevar: sin URL configurada ni
         cabecera Origin no se pinta un botón vacío. --}}
    @if (loginUrl)
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 26px 0 0 0;">
        <tr>
          <td style="background-color: #445cba; border-radius: 8px;">
            <a href="{{ loginUrl }}" target="_blank" style="display: inline-block; padding: 16px 33px; font-size: 13px; font-weight: 700; color: #ffffff; text-decoration: none; line-height: 16px;">
              {{ cta }}
            </a>
          </td>
        </tr>
      </table>

      <p style="margin: 14px 0 0 0; font-size: 12px; line-height: 20px; color: #6e757c;">
        {{ ctaCaption }}
      </p>
    @end
  @end
@end
