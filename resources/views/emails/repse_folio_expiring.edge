{{--
  Aviso a cumplimiento: vigencia del folio REPSE (renovación e informativas).
  Las cadenas llegan ya resueltas desde `RepseFolioExpiringMail.prepare()`
  según el idioma de la empresa destinataria (ES/EN), siguiendo el mismo
  patrón que `lactation_expiring.edge`.

  Convenciones:
   - Estilos 100% inline (compatibilidad Gmail/Outlook).
   - Layout con tablas (Outlook 2007-2019).
   - NO se exponen datos más allá de folio, tipo de evento, fecha y días restantes.
--}}<!DOCTYPE html>
<html lang="{{ language }}" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1f2937;">
  <div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">
    {{ preheader }}
  </div>

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f4f6fa;">
    <tr>
      <td align="center" style="padding: 24px 12px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width: 100%; max-width: 640px;">

          {{-- Encabezado de marca --}}
          <tr>
            <td style="background-color: {{ sidebarColor }}; padding: 18px 24px; border-top-left-radius: 12px; border-top-right-radius: 12px; color: #ffffff;">
              <div style="font-size: 18px; font-weight: 700; line-height: 1.2;">{{ tradeName }}</div>
              <div style="font-size: 13px; opacity: 0.9; margin-top: 4px;">{{ headerSubtitle }}</div>
            </td>
          </tr>

          {{-- Tarjeta principal --}}
          <tr>
            <td style="background-color: #ffffff; padding: 24px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">

              <p style="margin: 0 0 12px; font-size: 15px; line-height: 1.5;">
                {{ greeting }}
              </p>

              <p style="margin: 0 0 16px; font-size: 14px; line-height: 1.55; color: #374151;">
                {{ intro }}
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse; font-size: 13px; margin: 12px 0 20px;">
                <thead>
                  <tr style="background:#f3f4f6; text-align:left;">
                    <th style="padding:10px 8px; border-bottom:1px solid #e5e7eb; color:#4b5563; font-weight:600;">{{ headerFolio }}</th>
                    <th style="padding:10px 8px; border-bottom:1px solid #e5e7eb; color:#4b5563; font-weight:600;">{{ headerEventType }}</th>
                    <th style="padding:10px 8px; border-bottom:1px solid #e5e7eb; color:#4b5563; font-weight:600;">{{ headerDueDate }}</th>
                    <th style="padding:10px 8px; border-bottom:1px solid #e5e7eb; color:#4b5563; font-weight:600; text-align:center;">{{ headerDaysLeft }}</th>
                  </tr>
                </thead>
                <tbody>
                  @each(row in rows)
                    <tr>
                      <td style="padding:10px 8px; border-bottom:1px solid #f3f4f6; vertical-align:top;">
                        <strong style="color:#111827;">{{ row.folio }}</strong>
                      </td>
                      <td style="padding:10px 8px; border-bottom:1px solid #f3f4f6; vertical-align:top; color:#111827;">
                        {{ row.eventTypeLabel }}
                      </td>
                      <td style="padding:10px 8px; border-bottom:1px solid #f3f4f6; vertical-align:top; color:#111827;">
                        {{ row.dueDateLabel }}
                      </td>
                      <td style="padding:10px 8px; border-bottom:1px solid #f3f4f6; vertical-align:top; text-align:center;">
                        <span style="display:inline-block; padding:3px 8px; border-radius:999px; background:#fef3c7; color:#92400e; font-weight:600; font-size:12px;">
                          {{ row.daysLeftLabel }}
                        </span>
                      </td>
                    </tr>
                  @endeach
                </tbody>
              </table>

              <p style="margin: 0 0 8px; font-size: 12px; line-height: 1.5; color: #6b7280;">
                {{ legalNote }}
              </p>
            </td>
          </tr>

          {{-- Footer --}}
          <tr>
            <td style="padding: 14px 24px; text-align: center; font-size: 11px; color: #9ca3af;">
              {{ footer }}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
