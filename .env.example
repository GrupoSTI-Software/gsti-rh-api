#
# ================================================
# Modo de despliegue y configuración del endpoint demo
# ================================================
# APP_MODE: 'demo' habilita el módulo de generación de datos demo.
# En producción dejar vacío o no definir.
APP_MODE=
#
# Hash argon2id de la password de operación del endpoint demo.
# Generar con: node -e "require('argon2').hash(process.argv[1]).then(console.log)" <password>
# IMPORTANTE: el hash lleva muchos '$'; debe ir entre comillas dobles o el valor se corrompe.
# Ejemplo: DEMO_PASSWORD_HASH="$argon2id$v=19$m=65536,..."
DEMO_PASSWORD_HASH=
#
# Hostname permitido para el endpoint demo (default: demo.valanserh.com).
DEMO_ALLOWED_HOSTNAME="demo.valanserh.com"
#
# Patrón que debe contener el nombre de la DB activa para permitir ejecución.
# Evita accidentes si se apunta a una DB de producción.
DEMO_ALLOWED_DB_PATTERN="demo"
#
# Destinatario de los correos de auditoría del endpoint demo.
DEMO_AUDIT_EMAIL="desarrollo-software@gruposti.com"
