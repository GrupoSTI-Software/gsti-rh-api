# Overrides de `node ace test` (NODE_ENV=test). Sin secretos: el resto se hereda de .env.
# Apunta a una BD desechable para que la suite nunca toque la BD de desarrollo.
# `node ace migration:*` NO lee este archivo (no fija NODE_ENV): anteponer siempre
# `NODE_ENV=test DB_DATABASE=valanserh_test` a esos comandos.
# Overrides personales (otra BD, otro puerto) van en .env.test.local, que no se versiona.
# Quien lo use cambia también el nombre de la BD en esos comandos: una variable en línea
# gana sobre cualquier archivo .env, así que `DB_DATABASE=valanserh_test` ignoraría el suyo.
DB_DATABASE=valanserh_test
PORT=3334
# Valor FICTICIO, solo para pruebas: el sello de jornada (app/modules/work-journal/work_journal.hash.ts)
# lanza WJE.SYS.002 sin secreto y los specs del sello no pueden correr. No es ni se parece a un secreto real.
WORK_JOURNAL_HMAC_SECRET=test-only-work-journal-hmac-secret-not-for-production
# Plazos de retención del canal ADMS fijos para la suite, iguales a los defaults del spec
# ADMS 13.12 (app/modules/adms/retention/retention.constants.ts). Sin ellos la suite hereda
# los de .env de cada máquina. Vacíos no sirven: el cargador toma el valor vacío como no
# definido y se queda con el de .env.
ADMS_RAW_RETENTION_DAYS=180
ADMS_RAW_FAILED_RETENTION_DAYS=30
ADMS_COMMAND_RETENTION_DAYS=365
ADMS_PHOTO_PUBLICATION_RETENTION_DAYS=7
ADMS_QUARANTINE_RETENTION_DAYS=30
