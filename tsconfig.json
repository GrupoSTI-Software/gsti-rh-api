{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "baseUrl": "./",
    "paths": {
      "#models/*": ["./app/models/*"],
      "#constants/*": ["./app/constants/*"],
      "#utils/*": ["./app/utils/*"],
